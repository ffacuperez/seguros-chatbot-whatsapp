# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=tu_token_de_acceso_de_meta
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id
WHATSAPP_VERIFY_TOKEN=elegi_un_string_secreto_para_verificar_el_webhook
WHATSAPP_API_VERSION=v20.0

# Número de Sandra para recibir notificaciones (con código de país, sin +)
SANDRA_WHATSAPP_NUMBER=549XXXXXXXXXX

# Nombre de la plantilla aprobada en Meta Business Manager para notificar (RNF-07)
WHATSAPP_NOTIFICATION_TEMPLATE=nuevo_lead_cotizacion

# Redis (Upstash u otro proveedor)
REDIS_URL=rediss://default:TU_PASSWORD@tu-instancia.upstash.io:6379

# Google Sheets
GOOGLE_SHEETS_ID=tu_id_de_planilla
GOOGLE_SERVICE_ACCOUNT_EMAIL=tu-cuenta-de-servicio@tu-proyecto.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_PRIVATE_KEY_ACA\n-----END PRIVATE KEY-----\n"

# Servidor
PORT=3000
